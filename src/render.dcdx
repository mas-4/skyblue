#include "skyblue.h"

// Rendering walks a document's nodes and writes HTML to `out`.
//
// A page with a <sky-template> renders each of its blocks first, then
// renders the template with those blocks in its slots. Templates can
// use templates too; a block can contain a <sky-slot>, which passes the
// outer page's slot through. Includes are rendered in place, with the
// same slots and frontmatter as the file that includes them.
//
// Every file a page uses is recorded in its Page, for <sky-sources>.

Str render_page(Site *site, Doc *doc) {
  Buf out = {};
  Page page = {};
  Render r = {};
  r.site = site;
  r.out = &out;
  r.page = &page;
  r.doc(doc);
  return page.finish(site, out.str());
}

bool Render.doc(Doc *doc) {
  doc.active = true;
  if (ego.page)
    ego.page.add(doc.src);

  if (doc.templ.is_null()) {
    ego.nodes(doc, doc.body);
    doc.active = false;
    return true;
  }

  Str path = ego.site.resolve(doc, doc.templ, doc.templ_loc, true);
  Doc *templ = path.is_null() ? NULL : ego.site.load(path, doc.templ_loc);
  if (!templ) {
    doc.active = false;
    return false;
  }
  if (templ.active) {
    doc.templ_loc.error("template cycle: '%.*s' ends up using itself", SF(path));
    doc.active = false;
    return false;
  }

  // Render the blocks. Any slots we were given pass through them.
  Map *slots = alloc(sizeof(Map));
  Buf *out = ego.out;
  for (Node *block = doc.body; block; block = block.next) {
    Slot *slot = alloc(sizeof(Slot));
    Buf *buf = alloc(sizeof(Buf));
    ego.out = buf;
    ego.nodes(doc, block.body);
    slot.html = buf.str();
    slot.loc = block.loc;
    slots.put(block.name, slot);
  }
  ego.out = out;

  Map *outer = ego.slots;
  ego.slots = slots;
  bool ok = ego.doc(templ);
  ego.slots = outer;

  for (Node *block = doc.body; ok && block; block = block.next) {
    Slot *slot = slots.get(block.name);
    if (!slot.used)
      block.loc.warn("template '%.*s' has no <sky-slot name=\"%.*s\">",
                     SF(path), SF(block.name));
  }

  doc.active = false;
  return ok;
}

void Render.nodes(Doc *doc, Node *node) {
  for (; node; node = node.next)
    ego.node(doc, node);
}

void Render.node(Doc *doc, Node *node) {
  switch (node.kind) {
  case ND_TEXT:
    ego.out.push(node.text);
    return;
  case ND_VAR:
    ego.var(node);
    return;
  case ND_INCLUDE:
    ego.include(doc, node);
    return;
  case ND_MD_INCLUDE:
    ego.md_include(doc, node);
    return;
  case ND_SLOT:
    ego.slot(node);
    return;
  case ND_LIST:
    ego.list(doc, node);
    return;
  case ND_SOURCE:
    ego.show_source(doc, node);
    return;
  case ND_SOURCES:
    ego.list_sources(doc, node);
    return;
  case ND_BLOCK:
    // The parser reports blocks outside templated pages.
    return;
  }
}

void Render.var(Node *node) {
  if (node.ns.eqz("meta")) {
    Str *val = ego.site.meta.get(node.key);
    if (val)
      ego.out.push(*val);
    else
      node.loc.warn("the meta file has no key '%.*s'", SF(node.key));
    return;
  }

  if (node.ns.eqz("post")) {
    if (!ego.post) {
      node.loc.warn("${post.%.*s} only has a value in a markdown post's template or item",
                    SF(node.key));
      return;
    }
    Str *val = ego.post.get(node.key);
    if (val)
      ego.out.push(*val);
    else
      node.loc.warn("there is no ${post.%.*s}; posts have url and title", SF(node.key));
    return;
  }

  if (node.ns.eqz("source")) {
    if (!ego.source) {
      node.loc.warn("${source.%.*s} only has a value in a <sky-sources> item", SF(node.key));
      return;
    }
    Str *val = ego.source.get(node.key);
    if (val)
      ego.out.push(*val);
    else
      node.loc.warn("there is no ${source.%.*s}; sources have path, code and lines",
                    SF(node.key));
    return;
  }

  if (node.ns.eqz("sky")) {
    ego.sky_var(node);
    return;
  }

  // frontmatter
  if (!ego.fm) {
    node.loc.warn("${frontmatter.%.*s} only has a value in a markdown post's template",
                  SF(node.key));
    return;
  }
  Str *val = ego.fm.get(node.key);
  if (val)
    ego.out.push(*val);
  else
    node.loc.warn("'%.*s' has no frontmatter key '%.*s'", SF(ego.fm_path), SF(node.key));
}

// ${sky.*}: facts about skyblue and this build. The counts aren't known
// until every page has been rendered, so they're markers until then
// (see Site.fill_counts).
void Render.sky_var(Node *node) {
  Str key = node.key;
  if (key.eqz("version")) {
    ego.out.pushz(SKYBLUE_VERSION);
  } else if (key.eqz("compiler")) {
    ego.out.pushz(COMPILER_VERSION);
  } else if (key.eqz("date") || key.eqz("time")) {
    time_t t = ego.site.date;
    struct tm tm;
    gmtime_r(&t, &tm);
    char buf[32];
    strftime(buf, sizeof(buf), key.eqz("date") ? "%Y-%m-%d" : "%H:%M UTC", &tm);
    ego.out.pushz(buf);
  } else if (key.eqz("pages") || key.eqz("files") || key.eqz("ms")) {
    ego.out.push(strf("\x02sky.%.*s\x03", SF(key)));
  } else {
    node.loc.warn("there is no ${sky.%.*s}; skyblue has version, compiler, date, time, "
                  "pages, files and ms", SF(key));
  }
}

void Render.include(Doc *doc, Node *node) {
  Str path = ego.site.resolve(doc, node.path, node.loc, true);
  if (path.is_null())
    return;
  Doc *inc = ego.site.load(path, node.loc);
  if (!inc)
    return;
  if (inc.active) {
    node.loc.error("include cycle: '%.*s' ends up including itself", SF(path));
    return;
  }
  if (!inc.templ.is_null()) {
    node.loc.error("can't include '%.*s' because it uses <sky-template>", SF(path));
    return;
  }

  if (ego.page)
    ego.page.add(inc.src);
  inc.active = true;
  ego.nodes(inc, inc.body);
  inc.active = false;
}

void Render.md_include(Doc *doc, Node *node) {
  Str path = ego.site.resolve(doc, node.path, node.loc, true);
  if (path.is_null())
    return;
  Source *src = ego.site.read(path, node.loc);
  if (!src)
    return;
  if (ego.page)
    ego.page.add(src);
  Map fm = {};
  ego.out.push(markdown(split_frontmatter(src, &fm)));
}

void Render.slot(Node *node) {
  if (!ego.slots) {
    node.loc.warn("<sky-slot> only has a value in a template");
    return;
  }
  Slot *slot = ego.slots.get(node.name);
  if (slot) {
    slot.used = true;
    ego.out.push(slot.html);
  }
}

//
// <sky-markdown>: turn a directory of markdown files into pages, and
// render a list of links to them.
//

typedef struct Post Post;
struct Post {
  Str name;     // file name, e.g. "hello.md"
  Str path;     // source path
  Str out;      // output path, e.g. "blog/hello.html"
  Str url;      // e.g. "/blog/hello"
  Source *src;
  Str body;     // markdown, without frontmatter
  Str sort_key;
  Str title;
  Map fm;
  Map vars; // ${post.*}
};

static void put_var(Map *m, char *key, Str val) {
  Str *v = alloc(sizeof(Str));
  *v = val;
  m.put(str(key), v);
}

static int cmp_posts(const void *a, const void *b) {
  Post *p = (Post *)a;
  Post *q = (Post *)b;
  int c = p.sort_key.cmp(q.sort_key);
  return c ? c : p.name.cmp(q.name);
}

static Str strip_md(Str s) {
  return s.slice(0, s.len - 3);
}

void Render.list(Doc *doc, Node *node) {
  Site *site = ego.site;
  Str dir = site.resolve(doc, node.path, node.loc, false);
  if (dir.is_null())
    return;
  if (!is_dir(dir)) {
    node.loc.error("'%.*s' is not a directory", SF(dir));
    return;
  }
  if (!site.root.eqz(".") && path_rel(site.root, dir).eq(dir)) {
    node.loc.error("'%.*s' is outside the site", SF(dir));
    return;
  }

  Str templ_path = site.resolve(doc, node.templ, node.loc, true);
  Doc *templ = templ_path.is_null() ? NULL : site.load(templ_path, node.loc);
  if (!templ)
    return;

  long n;
  Str *names = list_dir(dir, &n);
  Post *posts = alloc(sizeof(Post) * (n + 1));
  int nposts = 0;

  for (long i = 0; i < n; i++) {
    Str path = path_join(dir, names[i]);
    if (!names[i].ends_with(".md") || !is_file(path))
      continue;
    Source *src = site.read(path, node.loc);
    if (!src)
      continue;

    Post *p = &posts[nposts++];
    p.name = names[i];
    p.path = path;
    p.src = src;
    p.body = split_frontmatter(src, &p.fm);
    Str rel = strip_md(path_rel(site.root, path));
    p.out = strf("%.*s.html", SF(rel));
    p.url = strf("/%.*s", SF(rel));

    Loc top = {src, 0};
    if (node.sort.len == 0) {
      p.sort_key = p.name;
    } else {
      Str *key = p.fm.get(node.sort);
      if (key)
        p.sort_key = *key;
      else
        top.warn("no '%.*s' in the frontmatter to sort by", SF(node.sort));
    }

    Str *title = p.fm.get(node.title);
    if (title) {
      p.title = *title;
    } else {
      top.warn("no '%.*s' in the frontmatter for the link text", SF(node.title));
      p.title = strip_md(p.name);
    }
  }

  qsort(posts, nposts, sizeof(Post), cmp_posts);
  if (node.descending) {
    for (int i = 0, j = nposts - 1; i < j; i++, j--) {
      Post tmp = posts[i];
      posts[i] = posts[j];
      posts[j] = tmp;
    }
  }
  for (int i = 0; i < nposts; i++) {
    put_var(&posts[i].vars, "url", posts[i].url);
    put_var(&posts[i].vars, "title", posts[i].title);
  }

  // The pages. Two listings of the same directory with the same
  // template (say, a blog page and the home page) share them.
  for (int i = 0; i < nposts; i++) {
    Post *p = &posts[i];
    Output *prev = site.find(p.out);
    if (prev && prev.origin.eq(p.path) && prev.templ.eq(templ_path))
      continue;
    if (templ.active) {
      node.loc.error("template cycle: '%.*s' ends up listing itself", SF(templ_path));
      return;
    }

    Map *slots = alloc(sizeof(Map));
    Slot *slot = alloc(sizeof(Slot));
    slot.html = markdown(p.body);
    slot.loc = node.loc;
    slots.put(node.name, slot);

    Buf page = {};
    Page *sources = alloc(sizeof(Page));
    sources.add(p.src);
    Render r = {};
    r.site = site;
    r.out = &page;
    r.page = sources;
    r.fm = &p.fm;
    r.fm_path = p.path;
    r.post = &p.vars;
    r.slots = slots;
    bool ok = r.doc(templ);

    if (ok && !slot.used)
      node.loc.warn("template '%.*s' has no <sky-slot name=\"%.*s\"> for the posts",
                    SF(templ_path), SF(node.name));

    Output *o = site.add(p.out, p.path, node.loc);
    if (o) {
      o.content = sources.finish(site, page.str());
      o.templ = templ_path;
      site.npages++;
      debug("rendered %.*s -> %.*s", SF(p.path), SF(p.out));
    }
  }

  // The list. With an item template, each entry is that template
  // rendered with the post's frontmatter and ${post.*}.
  if (!node.item.is_null()) {
    Str item_path = site.resolve(doc, node.item, node.loc, true);
    Doc *item = item_path.is_null() ? NULL : site.load(item_path, node.loc);
    if (!item)
      return;
    if (item.active) {
      node.loc.error("item template cycle: '%.*s' ends up listing itself", SF(item_path));
      return;
    }
    for (int i = 0; i < nposts; i++) {
      Render r = {};
      r.site = site;
      r.out = ego.out;
      r.page = ego.page;
      r.fm = &posts[i].fm;
      r.fm_path = posts[i].path;
      r.post = &posts[i].vars;
      r.doc(item);
    }
    return;
  }

  Buf *out = ego.out;
  out.pushz("<ul>\n");
  for (int i = 0; i < nposts; i++) {
    out.pushz("<li><a href=\"");
    out.html(posts[i].url);
    out.pushz("\">");
    out.html(posts[i].title);
    out.pushz("</a></li>\n");
  }
  out.pushz("</ul>\n");
}

//
// <sky-source>: a file, or part of one, as a highlighted listing.
//

void Render.show_source(Doc *doc, Node *node) {
  Str path = ego.site.resolve(doc, node.path, node.loc, false);
  if (path.is_null())
    return;
  Source *src = ego.site.read(path, node.loc);
  if (!src)
    return;

  // `from` is the first line that starts with it, ignoring indentation;
  // `to` is the next line after that, at the same indentation, that
  // starts with it. So from="void Render.slot" to="}" is a function.
  // Without `to`, the listing runs to the end of the file.
  long first = 1;
  long last = count_lines(src.text);
  if (!node.from.is_null()) {
    long indent;
    first = find_line(src.text, node.from, 1, -1, &indent);
    if (!first) {
      node.loc.error("no line in '%.*s' starts with \"%.*s\"", SF(path), SF(node.from));
      return;
    }
    if (!node.to.is_null()) {
      last = find_line(src.text, node.to, first + 1, indent, NULL);
      if (!last) {
        node.loc.error("no line in '%.*s' after line %ld starts with \"%.*s\"",
                       SF(path), first, SF(node.to));
        return;
      }
    }
  }
  ego.out.push(listing(src, first, last));
}

//
// <sky-sources>: every file the page was built from, each rendered with
// the item template.
//

void Render.list_sources(Doc *doc, Node *node) {
  if (!ego.page) {
    node.loc.warn("<sky-sources> only works in a page");
    return;
  }
  Pending *p = alloc(sizeof(Pending));
  p.doc = doc;
  p.node = node;
  p.marker = strf("\x02sky-sources %ld\x03", ego.page.npending++);
  p.next = ego.page.pending;
  ego.page.pending = p;
  ego.out.push(p.marker);
}

void Page.add(Source *src) {
  for (long i = 0; i < ego.nsrcs; i++)
    if (ego.srcs[i] == src || ego.srcs[i].path.eq(src.path))
      return;
  if (ego.nsrcs == ego.cap) {
    ego.cap = ego.cap ? ego.cap * 2 : 8;
    Source **srcs = alloc(sizeof(Source *) * ego.cap);
    if (ego.nsrcs)
      memcpy(srcs, ego.srcs, sizeof(Source *) * ego.nsrcs);
    ego.srcs = srcs;
  }
  ego.srcs[ego.nsrcs++] = src;
}

// Replace each <sky-sources> marker with its list. The item template
// counts as one of the page's sources too.
Str Page.finish(Site *site, Str html) {
  for (Pending *p = ego.pending; p; p = p.next) {
    Buf list = {};
    Str item_path = site.resolve(p.doc, p.node.item, p.node.loc, true);
    Doc *item = item_path.is_null() ? NULL : site.load(item_path, p.node.loc);
    if (item) {
      ego.add(item.src);
      for (long i = 0; i < ego.nsrcs; i++) {
        Source *src = ego.srcs[i];
        Map vars = {};
        put_var(&vars, "path", path_rel(site.root, src.path));
        put_var(&vars, "code", listing(src, 1, count_lines(src.text)));
        put_var(&vars, "lines", strf("%ld", count_lines(src.text)));
        Render r = {};
        r.site = site;
        r.out = &list;
        r.source = &vars;
        r.doc(item);
      }
    }
    html = html.replace(p.marker, list.str());
  }
  return html;
}
